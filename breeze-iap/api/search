og","tags":[],"type":"text","url":"/en/changelog#breaking-changes","content":"**Migrated to the Unity IAP v5 store API.** Requires `com.unity.purchasing` &#x2A;*5.3.0+**."},"12":{"id":"/en/changelog-10","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#breaking-changes","content":"The legacy `IStoreController` / `IExtensionProvider` / `IStoreListener` model was replaced with `UnityIAPServices.StoreController()` and its event-based API (`OnPurchasePending`, `OnPurchaseConfirmed`, `OnProductsFetched`, `OnPurchasesFetched`, …)."},"13":{"id":"/en/changelog-11","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#breaking-changes","content":"Initialization now runs `Connect()` → `FetchProducts(List<ProductDefinition>)` → `FetchPurchases()` instead of `ConfigurationBuilder` + `UnityPurchasing.Initialize`."},"14":{"id":"/en/changelog-12","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#breaking-changes","content":"Purchases are now confirmed against an **order**: `Confirm(Product)` is removed in favor of `Confirm(PendingOrder)`. `Confirm(PurchaseResult)` is unchanged."},"15":{"id":"/en/changelog-13","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#breaking-changes","content":"Removed the internal `InitializeResult` type."},"16":{"id":"/en/changelog-14","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#added","content":"`PurchaseResult.Order` (`PendingOrder`), plus convenience `Receipt` and `TransactionId` accessors sourced from `Order.Info`."},"17":{"id":"/en/changelog-15","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#added","content":"`PurchaseType.Deferred` for purchases awaiting external approval (e.g. Ask to Buy)."},"18":{"id":"/en/changelog-16","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#added","content":"Non-generic `Task.Timeout` overload to support awaiting `StoreController.Connect()`."},"19":{"id":"/en/changelog-17","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#notes","content":"The high-level API (`InitializeAsync`, `PurchaseAsync`, `Confirm(PurchaseResult)`, `GetPendingList`, `Restore`) is source-compatible with 2.0.0."},"20":{"id":"/en/changelog-18","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#breaking-changes-1","content":"**Unity IAP 5.0.0+ required.** v4 and below are no longer supported."},"21":{"id":"/en/changelog-19","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#breaking-changes-1","content":"Removed `OnInitializeFailed(InitializationFailureReason)` overload (no-message variant removed in IAP v5)."},"22":{"id":"/en/changelog-20","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#breaking-changes-1","content":"Removed `OnPurchaseFailed(Product, PurchaseFailureReason)` overload (replaced by `PurchaseFailureDescription` in IAP v5)."},"23":{"id":"/en/changelog-21","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#bug-fixes","content":"Fixed `NullReferenceException` caused by `initializeCompletionSource` never being initialized before `UnityPurchasing.Initialize` was called."},"24":{"id":"/en/changelog-22","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#bug-fixes","content":"Fixed inverted `_isInitialized` guard in `GetPendingList` and `PurchaseAsync` — both methods were blocking when initialized and allowing calls when not."},"25":{"id":"/en/changelog-23","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#bug-fixes","content":"Fixed missing `return` in `PurchaseAsync` after an early-exit error result."},"26":{"id":"/en/changelog-24","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#bug-fixes","content":"Removed dead code in the `List<InitializeDto>` overload (a dummy product was added after `ToArray()` was called, so it had no effect)."},"27":{"id":"/en/changelog-25","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#100--2024-09-17","content":"Initial release."},"28":{"id":"/en/changelog-26","page_id":"/en/changelog","tags":[],"type":"text","url":"/en/changelog#100--2024-09-17","content":"Async/await wrapper for Unity IAP with pending-purchase queue, timeout handling, and iOS restore support."},"29":{"id":"/en/getting-started","page_id":"/en/getting-started","type":"page","content":"Getting Started","breadcrumbs":["Docs"],"tags":[],"url":"/en/getting-started"},"30":{"id":"/en/getting-started-0","page_id":"/en/getting-started","tags":[],"type":"text","url":"/en/getting-started","content":"Installing and basic setup for Breeze IAP"},"31":{"id":"/en/getting-started-1","page_id":"/en/getting-started","type":"heading","tags":[],"url":"/en/getting-started#requirements","content":"Requirements"},"32":{"id":"/en/getting-started-2","page_id":"/en/getting-started","type":"heading","tags":[],"url":"/en/getting-started#installation","content":"Installation"},"33":{"id":"/en/getting-started-3","page_id":"/en/getting-started","type":"heading","tags":[],"url":"/en/getting-started#unity-package-manager-git-url","content":"Unity Package Manager (Git URL)"},"34":{"id":"/en/getting-started-4","page_id":"/en/getting-started","type":"heading","tags":[],"url":"/en/getting-started#basic-setup","content":"Basic setup"},"35":{"id":"/en/getting-started-5","page_id":"/en/getting-started","type":"heading","tags":[],"url":"/en/getting-started#1-define-the-product-list","content":"1\\. Define the product list"},"36":{"id":"/en/getting-started-6","page_id":"/en/getting-started","type":"heading","tags":[],"url":"/en/getting-started#2-initialize","content":"2\\. Initialize"},"37":{"id":"/en/getting-started-7","page_id":"/en/getting-started","type":"heading","tags":[],"url":"/en/getting-started#3-handle-pending-purchases","content":"3\\. Handle pending purchases"},"38":{"id":"/en/getting-started-8","page_id":"/en/getting-started","type":"heading","tags":[],"url":